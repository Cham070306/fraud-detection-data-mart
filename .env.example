# ============================================================
# .env.example — Mẫu cấu hình môi trường
# Cách dùng: copy file này thành .env rồi điền giá trị thực của bạn
#   cp .env.example .env        (Linux/Git Bash)
#   copy .env.example .env      (Windows CMD)
# ⚠️ KHÔNG commit file .env lên Git (đã có trong .gitignore)
# ============================================================

# --- SQL Server Connection ---
FRAUD_DB_SERVER=localhost\SQLEXPRESS   # Tên SQL Server instance
FRAUD_DB_NAME=FraudDW                  # Database phân tích
FRAUD_DB_USER=                         # Để trống khi dùng Windows Authentication
FRAUD_DB_PASSWORD=                     # Không commit mật khẩu thật
FRAUD_DB_DRIVER=ODBC Driver 17 for SQL Server
FRAUD_DB_TRUSTED_CONNECTION=true
